<odoo>
    <record model="ir.ui.view" id="vcp_platform_psc_form_view">
        <field name="model">vcp.platform.psc</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="key" />
                        <field name="name" />
                        <field name="member_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_platform_psc_tree_view">
        <field name="model">vcp.platform.psc</field>
        <field name="arch" type="xml">
            <list>
                <field name="key" />
                <field name="name" />
                <field name="member_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>
</odoo>
